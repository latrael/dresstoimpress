# copy to .env — never commit .env
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
APIFY_TOKEN=
NESSIE_API_KEY=

# Moss style memory (optional; falls back to swipe history)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# models: Haiku is ~20x cheaper than Sonnet; bump one task if quality needs it
CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_TAG_MODEL=claude-haiku-5-5
# CLAUDE_PAIR_MODEL=claude-sonnet-5-5

# spend guards: past these, endpoints use their non-AI fallbacks. GET /ai/usage to check.
AI_BUDGET_USD=5
MAX_TRYONS=150
PAIR_CACHE_SECONDS=600
# text tasks use Claude if ANTHROPIC_API_KEY is set, else Gemini (free tier ok). Force: claude|gemini|mock
# AI_TEXT_PROVIDER=
GEMINI_TEXT_MODEL=gemini-3.8-flash
# cheapest image model; gemini-3.1-flash-image if faces drift. Image gen needs billing on the Google project.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# 1 = fake AI output, no keys/credits needed (frontend dev)
MOCK_AI=0

# where try-on images are served from (ngrok/Render URL at the venue)
PUBLIC_BASE=http://localhost:8000

# storage: JSON files by default; set 1 + creds for Firestore
USE_FIRESTORE=0
GOOGLE_APPLICATION_CREDENTIALS=
