# copy to .env — never commit .env
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
APIFY_TOKEN=
NESSIE_API_KEY=

# Moss style memory (optional; falls back to swipe history)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# models (override if a newer one is out)
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# 1 = fake AI output, no keys/credits needed (frontend dev)
MOCK_AI=0

# where try-on images are served from (ngrok/Render URL at the venue)
PUBLIC_BASE=http://localhost:8000

# storage: JSON files by default; set 1 + creds for Firestore
USE_FIRESTORE=0
GOOGLE_APPLICATION_CREDENTIALS=
